@model CorporacionRubio.Web.Models.RestablecerAdminViewModel
@{
    Layout = null;
    ViewData["Title"] = "Restablecer administrador";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Restablecer administrador - Corporación Rubio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { min-height:100vh; margin:0; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#fff7ed,#fee2e2); font-family:'Segoe UI',system-ui,sans-serif; color:#0f172a; padding:24px; }
        .card-secure { width:100%; max-width:760px; border:0; border-radius:28px; box-shadow:0 30px 90px rgba(15,23,42,.18); overflow:hidden; }
        .secure-head { background:linear-gradient(135deg,#7f1d1d,#991b1b 60%,#f59e0b); color:white; padding:32px; }
        .form-control { border-radius:16px; min-height:48px; }
        .btn-main { background:#dc2626; border:0; border-radius:16px; font-weight:800; min-height:48px; color:white; }
    </style>
</head>
<body>
    <div class="card card-secure">
        <div class="secure-head">
            <h1 class="h3 fw-black mb-1"><i class="bi bi-person-fill-gear me-2"></i>Restablecimiento de administrador</h1>
            <p class="mb-0 opacity-75">Repara la cuenta principal, le asigna rol Administrador y desbloquea el acceso.</p>
        </div>
        <div class="card-body p-4 p-lg-5">
            <div class="alert alert-warning rounded-4 border-0">
                Código académico de recuperación: <strong>RUBIO-2026</strong><br />
                Al confirmar, el usuario <strong>admin@rubio.com</strong> quedará activo con la contraseña indicada.
            </div>
            <form asp-action="RestablecerAdministrador" method="post" class="vstack gap-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div>
                    <label asp-for="Codigo" class="form-label fw-bold">Código de restablecimiento</label>
                    <input asp-for="Codigo" class="form-control" placeholder="RUBIO-2026" />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="NuevaPassword" class="form-label fw-bold">Nueva contraseña del administrador</label>
                    <input asp-for="NuevaPassword" class="form-control" value="123456" />
                    <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                </div>
                <button class="btn btn-main" type="submit"><i class="bi bi-arrow-clockwise me-1"></i> Restablecer cuenta admin</button>
                <a class="btn btn-light border rounded-4 fw-semibold" href="@Url.Action("Login", "Account")">Volver al login</a>
            </form>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
