@{
    Layout = null;
    ViewData["Title"] = "Seleccionar acceso";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Seleccionar acceso - Corporación Rubio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(circle at 12% 10%, rgba(251,191,36,.24), transparent 28%),
                radial-gradient(circle at 88% 20%, rgba(15,23,42,.12), transparent 30%),
                linear-gradient(135deg, #f8fafc 0%, #eef2f7 55%, #e2e8f0 100%);
            font-family: Inter, 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 28px;
        }
        .access-shell { width: 100%; max-width: 1120px; }
        .access-header {
            text-align: center;
            max-width: 760px;
            margin: 0 auto 28px;
        }
        .brand-mark {
            width: 70px;
            height: 70px;
            border-radius: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #facc15, #f59e0b);
            color:#111827;
            font-size: 31px;
            box-shadow: 0 18px 42px rgba(245,158,11,.28);
            margin-bottom: 16px;
        }
        .fw-black { font-weight: 900; letter-spacing: -.03em; }
        .access-card {
            border: 1px solid #dbe3ef;
            border-radius: 28px;
            background: #fff;
            box-shadow: 0 28px 80px rgba(15,23,42,.12);
            overflow: hidden;
            height: 100%;
            transition: transform .18s ease, box-shadow .18s ease;
        }
        .access-card:hover { transform: translateY(-4px); box-shadow: 0 34px 95px rgba(15,23,42,.18); }
        .access-card .visual {
            min-height: 170px;
            padding: 26px;
            color: white;
            position: relative;
            background:
                radial-gradient(circle at 20% 20%, rgba(250,204,21,.30), transparent 28%),
                linear-gradient(135deg, #0f172a, #1e293b 62%, #92400e);
        }
        .access-card.client .visual {
            background:
                radial-gradient(circle at 20% 20%, rgba(16,185,129,.22), transparent 28%),
                linear-gradient(135deg, #0f172a, #164e63 58%, #047857);
        }
        .visual::after {
            content:"";
            position:absolute;
            inset:0;
            background-image:linear-gradient(135deg, rgba(255,255,255,.08) 25%, transparent 25%);
            background-size:45px 45px;
            opacity:.13;
        }
        .visual > * { position:relative; z-index:1; }
        .card-icon {
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: rgba(255,255,255,.14);
            display:flex;
            align-items:center;
            justify-content:center;
            font-size: 27px;
            color:#fde68a;
            border: 1px solid rgba(255,255,255,.18);
        }
        .card-body-area { padding: 28px; }
        .feature-list { list-style:none; padding:0; margin:18px 0 0; display:grid; gap:10px; }
        .feature-list li { display:flex; gap:10px; color:#475569; font-weight:650; }
        .feature-list i { color:#16a34a; }
        .btn-access {
            border: 0;
            min-height: 50px;
            border-radius: 16px;
            font-weight: 900;
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: #fff;
        }
        .btn-access:hover { color:#fff; background: linear-gradient(135deg, #1e293b, #92400e); }
        .btn-client { background: linear-gradient(135deg, #047857, #065f46); }
        .btn-client:hover { background: linear-gradient(135deg, #065f46, #064e3b); }
        .footer-note { color:#64748b; }
    </style>
</head>
<body>
    <div class="access-shell">
        <div class="access-header">
            <div class="brand-mark"><i class="bi bi-shield-lock-fill"></i></div>
            <a href="@Url.Action("Index", "Home")" class="text-decoration-none fw-bold text-primary"><i class="bi bi-arrow-left me-1"></i> Volver a la página oficial</a>
            <h1 class="display-6 fw-black mt-3 mb-2">Seleccione el tipo de acceso</h1>
            <p class="lead text-muted mb-0">Corporación Rubio separa el ingreso interno del portal cliente para mantener permisos claros, trazabilidad y una experiencia adecuada según el perfil.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="access-card">
                    <div class="visual d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <div class="card-icon"><i class="bi bi-building-lock"></i></div>
                            <span class="badge rounded-pill text-bg-warning text-dark px-3 py-2 fw-bold">Personal autorizado</span>
                        </div>
                        <div class="mt-4">
                            <h2 class="fw-black mb-2">Acceso interno</h2>
                            <p class="mb-0 text-white-50">Administración, ventas y logística operan desde paneles separados según sus responsabilidades.</p>
                        </div>
                    </div>
                    <div class="card-body-area">
                        <p class="text-muted mb-0">Use esta opción para ingresar a los módulos internos de inventario, pedidos, atención comercial, despacho, auditoría y gestión de usuarios.</p>
                        <ul class="feature-list">
                            <li><i class="bi bi-check-circle-fill"></i><span>Administrador: seguridad, usuarios, auditoría y control general.</span></li>
                            <li><i class="bi bi-check-circle-fill"></i><span>Ventas: solicitudes comerciales, aprobación y gestión de pedidos.</span></li>
                            <li><i class="bi bi-check-circle-fill"></i><span>Logística: stock, movimientos, preparación, despacho y entrega.</span></li>
                        </ul>
                        <a class="btn btn-access w-100 mt-4 d-flex align-items-center justify-content-center gap-2" href="@Url.Action("Login", "Account", new { perfil = "interno" })">
                            <span>Ingresar como personal interno</span><i class="bi bi-arrow-right-short fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="access-card client">
                    <div class="visual d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <div class="card-icon"><i class="bi bi-person-badge"></i></div>
                            <span class="badge rounded-pill text-bg-success px-3 py-2 fw-bold">Cliente registrado</span>
                        </div>
                        <div class="mt-4">
                            <h2 class="fw-black mb-2">Portal cliente</h2>
                            <p class="mb-0 text-white-50">Clientes corporativos registran solicitudes y consultan el estado de atención de sus pedidos.</p>
                        </div>
                    </div>
                    <div class="card-body-area">
                        <p class="text-muted mb-0">Use esta opción para acceder al catálogo disponible, registrar requerimientos comerciales y revisar el avance de atención validado por ventas y logística.</p>
                        <ul class="feature-list">
                            <li><i class="bi bi-check-circle-fill"></i><span>Solicitud de productos con cantidades y ciudad de entrega.</span></li>
                            <li><i class="bi bi-check-circle-fill"></i><span>Estado del pedido desde recepción hasta entrega.</span></li>
                            <li><i class="bi bi-check-circle-fill"></i><span>Catálogo comercial conectado al inventario del sistema.</span></li>
                        </ul>
                        <a class="btn btn-access btn-client w-100 mt-4 d-flex align-items-center justify-content-center gap-2" href="@Url.Action("Login", "Account", new { perfil = "cliente" })">
                            <span>Ingresar como cliente corporativo</span><i class="bi bi-arrow-right-short fs-4"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center small footer-note mt-4"><i class="bi bi-shield-check"></i> Accesos protegidos con ASP.NET Core Identity y autorización por roles.</div>
    </div>
</body>
</html>
