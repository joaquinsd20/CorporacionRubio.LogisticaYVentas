@model CorporacionRubio.Web.Models.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Recuperar contraseña";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recuperar contraseña - Corporación Rubio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { min-height:100vh; margin:0; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#f8fafc,#e0f2fe); font-family:'Segoe UI',system-ui,sans-serif; color:#0f172a; padding:24px; }
        .card-secure { width:100%; max-width:760px; border:0; border-radius:28px; box-shadow:0 30px 90px rgba(15,23,42,.18); overflow:hidden; }
        .secure-head { background:linear-gradient(135deg,#0f172a,#1e293b 65%,#f59e0b); color:white; padding:32px; }
        .icon-pill { width:54px; height:54px; border-radius:18px; background:#f59e0b; color:#111827; display:grid; place-items:center; font-size:1.6rem; }
        .form-control { border-radius:16px; min-height:48px; }
        .btn-main { background:#f59e0b; border:0; border-radius:16px; font-weight:800; min-height:48px; color:#111827; }
    </style>
</head>
<body>
    <div class="card card-secure">
        <div class="secure-head d-flex gap-3 align-items-center">
            <div class="icon-pill"><i class="bi bi-key-fill"></i></div>
            <div>
                <h1 class="h3 fw-black mb-1">Recuperación de acceso</h1>
                <p class="mb-0 opacity-75">Genera un token seguro de ASP.NET Core Identity para restablecer la contraseña.</p>
            </div>
        </div>
        <div class="card-body p-4 p-lg-5">
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success rounded-4 border-0"><i class="bi bi-check-circle me-2"></i>@TempData["Mensaje"]</div>
            }
            @if (TempData["ResetLink"] != null)
            {
                <div class="alert alert-warning rounded-4 border-0">
                    <strong>Enlace académico de restablecimiento:</strong><br />
                    <a class="fw-bold" href="@TempData["ResetLink"]">Abrir enlace para cambiar contraseña</a>
                    <div class="small text-muted mt-1">En producción este enlace se enviaría al correo del usuario.</div>
                </div>
            }
            <form asp-action="ForgotPassword" method="post" class="vstack gap-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div>
                    <label asp-for="Email" class="form-label fw-bold">Correo registrado</label>
                    <input asp-for="Email" class="form-control" placeholder="usuario@corporacionrubio.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button class="btn btn-main" type="submit"><i class="bi bi-shield-lock me-1"></i> Generar token de restablecimiento</button>
                <a class="btn btn-light border rounded-4 fw-semibold" href="@Url.Action("Login", "Account")"><i class="bi bi-arrow-left me-1"></i> Volver al login</a>
            </form>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
