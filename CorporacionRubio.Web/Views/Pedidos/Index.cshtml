@model CorporacionRubio.Business.Dto.PedidosIndexDto
@{
    ViewData["Title"] = "Pedidos";
    var pedidos = Model?.Pedidos ?? new List<Pedido>();
    var productos = Model?.Productos ?? new List<Producto>();
    var usuarios = Model?.Usuarios ?? new List<Usuario>();
    var totalVentas = pedidos.Sum(p => p.Total);
}

<div class="container-fluid px-4 mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted small">Dashboard</a></li><li class="breadcrumb-item active fw-semibold small">Pedidos</li></ol></nav>
            <h1 class="h4 fw-bold text-dark m-0"><i class="bi bi-cart-check-fill text-success me-2"></i> Gestión comercial de ventas, pagos y pedidos</h1>
            <p class="text-muted small mb-0">Registra ventas internas con stock validado, código de operación automático, descuento de inventario y trazabilidad de almacén.</p>
        </div>
        <button class="btn btn-success rounded-3 fw-semibold text-white" data-bs-toggle="modal" data-bs-target="#modalNuevoPedido">
            <i class="bi bi-plus-circle me-1"></i> Registrar venta
        </button>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><span class="text-muted small">Pedidos</span><h3 class="fw-bold mb-0">@pedidos.Count</h3></div></div></div>
        <div class="col-6 col-xl-3"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><span class="text-muted small">Total vendido</span><h3 class="fw-bold mb-0">S/ @totalVentas.ToString("F2")</h3></div></div></div>
        <div class="col-6 col-xl-3"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><span class="text-muted small">Productos disponibles</span><h3 class="fw-bold mb-0">@productos.Count</h3></div></div></div>
        <div class="col-6 col-xl-3"><div class="card border-0 shadow-sm rounded-4"><div class="card-body"><span class="text-muted small">Clientes/usuarios</span><h3 class="fw-bold mb-0">@usuarios.Count</h3></div></div></div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 bg-white">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-receipt text-success me-2"></i>Pedidos comerciales registrados</strong>
            <span class="badge bg-success-subtle text-success">@pedidos.Count pedidos</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-secondary">
                    <tr>
                        <th class="ps-4">Pedido</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th class="text-end">Total</th>
                        <th>Pago</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (pedidos.Any())
                {
                    foreach (var pedido in pedidos)
                    {
                        <tr>
                            <td class="ps-4 fw-bold font-monospace">#@pedido.IdPedido</td>
                            <td class="small text-muted">@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><i class="bi bi-building text-muted me-2"></i>@(pedido.Usuario?.Nombre ?? $"Usuario #{pedido.IdUsuario}")</td>
                            <td class="text-end fw-bold">S/ @pedido.Total.ToString("F2")</td>
                            <td><span class="badge bg-success-subtle text-success rounded-pill px-3">@(pedido.PagoPedido?.EstadoPago ?? "No registrado")</span></td>
                            <td>
                                @{
                                    var estado = pedido.Estado ?? "Sin estado";
                                    var badge = estado == "Entregado" || estado == "Despachado" ? "bg-success" : estado == "Cancelado" ? "bg-danger" : "bg-warning text-dark";
                                }
                                <span class="badge @badge rounded-pill px-3">@estado</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-success" onclick="abrirModalDetalles(@pedido.IdPedido)"><i class="bi bi-eye"></i> Detalle</button>
                                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalEstado" data-id="@pedido.IdPedido" data-estado="@(pedido.Estado ?? "Pendiente")"><i class="bi bi-pencil-square"></i> Estado</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-1 d-block"></i>No existen pedidos registrados.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade admin-safe-modal" data-bs-backdrop="false" data-bs-keyboard="true" id="modalNuevoPedido" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-controller="Pedidos" asp-action="RegistrarPedido" method="post" id="formPedido">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light border-0">
                    <div><h5 class="modal-title fw-bold"><i class="bi bi-cart-plus text-success me-2"></i>Registrar venta interna con pago</h5><small class="text-muted">Al confirmar la venta el sistema genera el código de operación, descuenta stock y registra el movimiento de almacén.</small></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Cliente / Usuario</label>
                            <select name="idUsuarioCliente" class="form-select" required>
                                <option value="">Seleccione</option>
                                @foreach (var usuario in usuarios)
                                {
                                    <option value="@usuario.IdUsuario">@usuario.Nombre (@(usuario.Rol?.NombreRol ?? "Sin rol"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end justify-content-md-end">
                            <button type="button" class="btn btn-outline-success" id="btnAgregarItem"><i class="bi bi-plus-circle me-1"></i>Agregar producto</button>
                        </div>
                    </div>
                    <div class="table-responsive border rounded-3">
                        <table class="table align-middle mb-0" id="tablaItemsPedido">
                            <thead class="table-light small text-uppercase text-secondary"><tr><th>Producto</th><th style="width:160px">Cantidad</th><th style="width:160px">Stock</th><th style="width:160px">Precio</th><th style="width:160px">Subtotal</th><th style="width:70px"></th></tr></thead>
                            <tbody></tbody>
                            <tfoot><tr><td colspan="4" class="text-end fw-bold">Total</td><td class="fw-bold" id="pedidoTotal">S/ 0.00</td><td></td></tr></tfoot>
                        </table>
                    </div>
                    <div class="payment-box mt-3">
                        <div class="payment-box-title"><i class="bi bi-credit-card-2-front"></i><span>Condición de pago y operación automática</span></div>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Método o condición</label>
                                <select name="metodoPago" class="form-select" id="metodoPagoInterno" required>
                                    <option value="">Seleccione</option>
                                    <option>Transferencia bancaria</option>
                                    <option>Yape / Plin</option>
                                    <option>Depósito bancario</option>
                                    <option>Efectivo en caja</option>
                                    <option>Pago contra entrega</option>
                                    <option>Crédito corporativo</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Código de operación</label>
                                <input class="form-control operation-code-preview" value="Lo genera el sistema" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Comprobante</label>
                                <select name="tipoComprobante" class="form-select">
                                    <option>Boleta</option>
                                    <option>Factura</option>
                                    <option>Nota de pedido</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Observación</label>
                                <input name="observacionPago" class="form-control" maxlength="200" placeholder="Titular, caja, condición o acuerdo comercial" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-success text-white fw-bold">Guardar venta y generar operación</button></div>
            </form>
        </div>
    </div>
</div>

<template id="templateItemPedido">
    <tr>
        <td>
            <select name="idProductos" class="form-select producto-select" required>
                <option value="">Seleccione producto</option>
                @foreach (var p in productos)
                {
                    <option value="@p.IdProducto" data-precio="@((p.PrecioUnitario ?? 0m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" data-stock="@(p.StockActual ?? 0)">@p.Nombre - Stock @(p.StockActual ?? 0) - S/ @((p.PrecioUnitario ?? 0m).ToString("F2"))</option>
                }
            </select>
        </td>
        <td><input name="cantidades" type="number" min="1" value="1" class="form-control cantidad-input" required /></td>
        <td class="stock-label text-muted">0</td>
        <td class="precio-label text-muted">S/ 0.00</td>
        <td class="subtotal-label fw-bold">S/ 0.00</td>
        <td><button type="button" class="btn btn-sm btn-outline-danger btn-remover"><i class="bi bi-x-lg"></i></button></td>
    </tr>
</template>

<div class="modal fade admin-safe-modal" data-bs-backdrop="false" data-bs-keyboard="true" id="modalVerDetalles" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 shadow rounded-4">
        <div class="modal-header bg-light border-0"><h5 class="modal-title fw-bold"><i class="bi bi-receipt text-success me-2"></i>Detalle comercial del pedido <span id="detallePedidoTitulo"></span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><div class="table-responsive"><table class="table table-sm align-middle"><thead class="table-light"><tr><th>Producto</th><th class="text-center">Cantidad</th><th class="text-end">Subtotal</th></tr></thead><tbody id="detallePedidoBody"><tr><td colspan="3" class="text-center text-muted py-4">Cargando...</td></tr></tbody></table></div></div>
    </div></div>
</div>

<div class="modal fade admin-safe-modal" data-bs-backdrop="false" data-bs-keyboard="true" id="modalEstado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow rounded-4">
        <form asp-controller="Pedidos" asp-action="ActualizarEstado" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idPedido" id="estadoIdPedido" />
            <div class="modal-header bg-light border-0"><h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Actualizar seguimiento del pedido</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><label class="form-label fw-semibold">Nuevo estado operativo</label><select name="estado" id="estadoSelect" class="form-select" required><option>Pendiente</option><option>Procesado</option><option>Validado</option><option>En Despacho</option><option>Despachado</option><option>Entregado</option><option>Cancelado</option></select></div>
            <div class="modal-footer border-0"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary fw-bold">Guardar estado</button></div>
        </form>
    </div></div>
</div>

@section Scripts {
<script>
    const template = document.getElementById('templateItemPedido');
    const tbody = document.querySelector('#tablaItemsPedido tbody');

    function actualizarFila(row) {
        const select = row.querySelector('.producto-select');
        const option = select.options[select.selectedIndex];
        const precio = Number(option?.dataset?.precio || 0);
        const stock = Number(option?.dataset?.stock || 0);
        const cantidadInput = row.querySelector('.cantidad-input');
        const cantidad = Number(cantidadInput.value || 0);
        row.querySelector('.stock-label').textContent = stock;
        row.querySelector('.precio-label').textContent = 'S/ ' + precio.toFixed(2);
        row.querySelector('.subtotal-label').textContent = 'S/ ' + (precio * cantidad).toFixed(2);
        cantidadInput.max = stock > 0 ? stock : 1;
        actualizarTotal();
    }

    function actualizarTotal() {
        let total = 0;
        tbody.querySelectorAll('tr').forEach(row => {
            const select = row.querySelector('.producto-select');
            const option = select.options[select.selectedIndex];
            const precio = Number(option?.dataset?.precio || 0);
            const cantidad = Number(row.querySelector('.cantidad-input').value || 0);
            total += precio * cantidad;
        });
        document.getElementById('pedidoTotal').textContent = 'S/ ' + total.toFixed(2);
    }

    function agregarItem() {
        const clone = template.content.cloneNode(true);
        const row = clone.querySelector('tr');
        row.querySelector('.producto-select').addEventListener('change', () => actualizarFila(row));
        row.querySelector('.cantidad-input').addEventListener('input', () => actualizarFila(row));
        row.querySelector('.btn-remover').addEventListener('click', () => { row.remove(); actualizarTotal(); });
        tbody.appendChild(row);
        actualizarFila(row);
    }

    document.getElementById('btnAgregarItem')?.addEventListener('click', agregarItem);
    document.getElementById('modalNuevoPedido')?.addEventListener('shown.bs.modal', () => { if (!tbody.children.length) agregarItem(); });
    document.getElementById('modalNuevoPedido')?.addEventListener('hidden.bs.modal', () => { tbody.innerHTML = ''; actualizarTotal(); document.getElementById('formPedido')?.reset(); });

    document.getElementById('formPedido')?.addEventListener('submit', e => {
        const metodo = document.querySelector('[name="metodoPago"]')?.value?.trim();
        if (!tbody.children.length) {
            e.preventDefault();
            alert('Agrega al menos un producto a la venta.');
            return;
        }
        if (!metodo) {
            e.preventDefault();
            alert('Selecciona el método o condición de pago antes de guardar la venta.');
        }
    });

    async function abrirModalDetalles(idPedido) {
        const modal = new bootstrap.Modal(document.getElementById('modalVerDetalles'));
        const body = document.getElementById('detallePedidoBody');
        document.getElementById('detallePedidoTitulo').innerText = '#' + idPedido;
        body.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-4">Cargando...</td></tr>';
        modal.show();

        const response = await fetch('@Url.Action("Detalle", "Pedidos")?idPedido=' + idPedido);
        const data = await response.json();
        if (!data.length) {
            body.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-4">Este pedido no tiene ítems.</td></tr>';
            return;
        }
        body.innerHTML = data.map(item => `<tr><td class="fw-semibold">${item.producto}</td><td class="text-center">${item.cantidad}</td><td class="text-end fw-bold">S/ ${Number(item.subtotal).toFixed(2)}</td></tr>`).join('');
    }

    window.abrirModalDetalles = abrirModalDetalles;

    document.getElementById('modalEstado')?.addEventListener('show.bs.modal', event => {
        const b = event.relatedTarget;
        document.getElementById('estadoIdPedido').value = b.getAttribute('data-id');
        document.getElementById('estadoSelect').value = b.getAttribute('data-estado') || 'Pendiente';
    });
</script>
}

<style>
    .font-monospace { font-family: Consolas, 'Liberation Mono', monospace; }
</style>
